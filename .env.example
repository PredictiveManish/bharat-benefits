# Copy this file to .env and add your keys.
# Do not commit .env.

# Sarvam AI key (access from https://dashboard.sarvam.ai)
SARVAM_API_KEY=

SARVAM_STT_MODEL=saaras:v3
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya

# ChromaDB - open-source vector store (self-hosted, no API key needed)
CHROMA_DB_PATH=./chroma_data
CHROMA_COLLECTION=bharat-benefits

# Embedding model (auto-downloaded on first run)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval settings
TOP_K=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50